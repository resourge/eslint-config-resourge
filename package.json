{
	"name": "eslint-config-resourge",
	"version": "1.9.1",
	"description": "",
	"main": "index.js",
	"type": "module",
  	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"commitizen": "git add . && git-cz",
		"commit": "git pull && npm run commitizen",
		"semantic-release": "semantic-release"
	},
	"files": [
		"./lib",
		"./src",
		"./index.ts",
		"./react.ts",
		"./react-native.ts"
	],
	"author": "José Silva Oliveira",
	"license": "ISC",
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/eslint-plugin-jsx-a11y": "^6.10.1",
		"eslint": "^10.13.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.13.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"typescript-eslint": "^8.72.1"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@types/node": "^26.6.5",
		"cz-conventional-changelog": "^3.3.0",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/resourge/eslint-config-resourge.git"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
